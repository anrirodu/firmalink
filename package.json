{
  "name": "firma-link",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4210",
    "build": "node update-build-date.js && ng build",
    "build:prod": "node update-build-date.js && ng build --configuration production",
    "update-build-date": "node update-build-date.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "bun@1.2.10",
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "datatables.net": "^3.0.2",
    "datatables.net-bs5": "^3.0.2",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
